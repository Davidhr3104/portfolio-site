# Copy to .env.local and set once you have a real deployed URL (Vercel
# subdomain or custom domain). Used for sitemap.xml, robots.txt, canonical
# URLs, and structured data.
NEXT_PUBLIC_SITE_URL=https://your-domain-here.vercel.app

# From resend.com -> API Keys. Powers the /api/contact route that sends
# the Contact form's messages. Without a verified sending domain, Resend's
# sandbox mode only delivers to the email address the account was created
# with -- fine here since that's the same inbox the form should reach.
RESEND_API_KEY=
